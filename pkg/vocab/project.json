{
    "categories": {
        "forming": [
            "defined"
        ],
        "executing": [
            "executing",
            "closing"
        ],
        "terminal": [
            "closed",
            "dropped"
        ]
    },
    "when": {
        "defined": "Charter written (problem, cross-issue requirements, done_when, scope); no train dispatched yet",
        "executing": "the first train is dispatched; the TL grooms Trains and appends Decisions",
        "closing": "every mvp_scope issue has landed; the done_when audit is the remaining work",
        "closed": "done_when audit passed; retro recorded and the file archived",
        "dropped": "no longer worth pursuing"
    },
    "discovery": {
        "home": "workshop/projects",
        "glob": "*.md",
        "archive": "workshop/history"
    },
    "scaffold": {
        "collaboration_mode": "collaboration",
        "sections": [
            {
                "name": "Charter"
            },
            {
                "name": "Trains",
                "seed": "| Train | Cars, in order | Slot |\n|---|---|---|"
            },
            {
                "name": "Breakdown",
                "seed": "- [ ]"
            },
            {
                "name": "Log"
            },
            {
                "name": "Decisions"
            }
        ]
    },
    "lifecycle": [
        {
            "from": "defined",
            "to": "executing",
            "event": "execute",
            "guards": [
                "trains-present"
            ]
        },
        {
            "from": "executing",
            "to": "closing",
            "event": "wrap",
            "guards": [
                "mvp-landed"
            ]
        },
        {
            "from": "closing",
            "to": "executing",
            "event": "reopen",
            "guards": []
        },
        {
            "from": "closing",
            "to": "closed",
            "event": "close",
            "guards": [
                "retro-recorded"
            ]
        },
        {
            "from": "defined",
            "to": "dropped",
            "event": "drop",
            "guards": []
        },
        {
            "from": "executing",
            "to": "dropped",
            "event": "drop",
            "guards": [
                "retro-recorded"
            ]
        },
        {
            "from": "closing",
            "to": "dropped",
            "event": "drop",
            "guards": [
                "retro-recorded"
            ]
        }
    ],
    "laws": {
        "documented-value": {
            "defined": "Charter written (problem, cross-issue requirements, done_when, scope); no train dispatched yet",
            "executing": "the first train is dispatched; the TL grooms Trains and appends Decisions",
            "closing": "every mvp_scope issue has landed; the done_when audit is the remaining work",
            "closed": "done_when audit passed; retro recorded and the file archived",
            "dropped": "no longer worth pursuing"
        },
        "reachable": {
            "executing": true,
            "closing": true,
            "closed": true,
            "dropped": true
        },
        "escapable": {
            "defined": true,
            "executing": true,
            "closing": true
        }
    }
}
